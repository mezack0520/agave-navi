<!DOCTYPE html>
<html lang="ja">
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-NKY8V1H8HY"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-NKY8V1H8HY');
  </script>
  <meta charset="UTF-8">
  <link rel="canonical" href="https://agave-navi.com/events/{{slug}}.html">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="{{robotsMeta}}">
  <title>{{name}} | アガベイベントナビ</title>
  <meta name="description" content="{{metaDescription}}">
  <meta name="keywords" content="{{name}},即売会,アガベ,多肉植物,塊根植物,コーデックス,ビザールプランツ,即売会,イベント">
  <meta property="og:title" content="{{name}} | アガベイベントナビ">
  <meta property="og:description" content="{{metaDescription}}">
  <meta property="og:type" content="article">
  <meta property="og:url" content="https://agave-navi.com/events/{{slug}}.html">
  <meta property="og:image" content="{{ogImage}}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{name}} | アガベイベントナビ">
  <meta name="twitter:description" content="{{metaDescription}}">
  <meta name="twitter:image" content="{{ogImage}}">
  <link rel="icon" type="image/svg+xml" href="../favicon.svg?v=2">
  <link rel="icon" type="image/x-icon" href="../favicon.ico?v=2">
  <link rel="apple-touch-icon" sizes="180x180" href="../apple-touch-icon.png?v=2">
  <link rel="manifest" href="../manifest.webmanifest?v=2">
  <meta name="theme-color" content="#111">
    <link rel="alternate" type="application/rss+xml" title="アガベイベントナビ 新着イベント" href="/rss.xml">
  <!-- Speed: preconnect to common image hosts -->
  <link rel="preconnect" href="https://i0.wp.com" crossorigin>
  <link rel="preconnect" href="https://hb.afl.rakuten.co.jp" crossorigin>
  <link rel="preconnect" href="https://ck.jp.ap.valuecommerce.com" crossorigin>
  <link rel="dns-prefetch" href="https://m.media-amazon.com">

  <link rel="stylesheet" href="../style.css?v={{cssVersion}}">
{{eventJsonLd}}
{{breadcrumbJsonLd}}
</head>
<body>

{{siteHeader}}

{{breadcrumb}}

  <main class="detail-page">

    <header class="event-hero">
      <div class="eh-kicker">
        <span class="detail-status-badge" data-date="{{date}}" data-date-end="{{dateEnd}}"{{cancelledAttr}}></span>
        <span class="eh-chip">{{primaryCategory}}</span>
        <!-- 都道府県はパンくずの「全国 > 関東 > 埼玉」に出ているので
             ここには置かない。同じ言葉が2行続くだけだった
             (2026-09-08 指摘) -->
      </div>
      <h1 class="eh-title">{{name}}</h1>

      <div class="eh-lead">
{{heroSection}}
        <div class="eh-body">
        <div class="eh-spec">
          <div class="info-row">
            <span class="info-label">日時</span>
            <span class="info-value">{{dateDisplayFull}}</span>
          </div>
          <div class="info-row">
            <span class="info-label">会場</span>
            <span class="info-value">{{venue}}</span>
          </div>
{{venueMap}}
{{prefectureRow}}
{{admissionRow}}
{{timeRow}}
{{accessRow}}
{{officialLinksRows}}
{{weatherRow}}
        </div>
{{heroMetaNote}}
        </div>
      </div>

      <div class="eh-actions">
        <button class="detail-fav-btn" id="favBtn" onclick="toggleFav()">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
          </svg>
          <span id="favLabel">行きたい</span>
        </button>
{{gcalButton}}
{{shareSection}}
      </div>
    </header>

    <div class="detail-main">
        <div class="detail-section">
{{cancelNotice}}
          <h2 class="detail-section-title" data-kicker="ABOUT">概要</h2>
          <p>{{description}}</p>
{{dataSummary}}
        </div>

{{affiliateBlock}}

{{instagramSection}}


{{enrichedContent}}
        <div class="detail-back">
          <a href="/?region={{regionEncoded}}" class="detail-back-link">{{region}}のイベントに戻る</a>
        </div>
    </div>

  </main>

  <p class="correction-notice">内容に誤りがあれば <a href="/contact.html">お問い合わせ</a> から教えてください。確認して直します。</p>

{{siteFooter}}

  <script src="../affiliate.js?v={{jsVersion}}"></script>
  <script src="../status-auto.js?v={{jsVersion}}"></script>
  <script>
    const SLUG = '{{slug}}';
    function toggleFav() {
      let favs = JSON.parse(localStorage.getItem('aen_favs') || '[]');
      const idx = favs.indexOf(SLUG);
      if (idx >= 0) { favs.splice(idx, 1); }
      else { favs.push(SLUG); }
      localStorage.setItem('aen_favs', JSON.stringify(favs));
      updateFavUI();
    }
    function updateFavUI() {
      const favs = JSON.parse(localStorage.getItem('aen_favs') || '[]');
      const btn = document.getElementById('favBtn');
      const label = document.getElementById('favLabel');
      if (favs.includes(SLUG)) {
        btn.classList.add('is-fav');
        label.textContent = '行きたい！';
      } else {
        btn.classList.remove('is-fav');
        label.textContent = '行きたい';
      }
      const badge = document.getElementById('ikitaiBadge');
      if (badge) badge.textContent = favs.length || '';
    }
    updateFavUI();
  </script>
</body>
</html>
